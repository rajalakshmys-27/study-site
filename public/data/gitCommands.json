{
  "gitCommands": [
    {
      "id": 111,
      "topic": "Configuration",
      "commands": [
        {
          "id": 1,
          "description": "Set username for commits (affects all repositories)",
          "command": "git config --global user.name \"Your Name\""
        },
        {
          "id": 2,
          "description": "Set email for commits (affects all repositories)",
          "command": "git config --global user.email \"you@example.com\""
        },
        {
          "id": 3,
          "description": "Set default editor for git (affects all repositories)",
          "command": "git config --global core.editor \"editor\""
        },
        {
          "id": 4,
          "description": "List all git configurations",
          "command": "git config --list"
        }
      ]
    },
    {
      "id": 112,
      "topic": "Repository",
      "commands": [
        {
          "id": 5,
          "description": "Initialize a local repository in the working directory",
          "command": "git init"
        },
        {
          "id": 6,
          "description": "Clone a remote repository to the local machine",
          "command": "git clone <repo>"
        }
      ]
    },
    {
      "id": 113,
      "topic": "Branching",
      "commands": [
        {
          "id": 7,
          "description": "List branches in the local repository",
          "command": "git branch"
        },
        {
          "id": 8,
          "description": "Create a new branch in the local repository",
          "command": "git branch <name>"
        },
        {
          "id": 9,
          "description": "Switch to a different branch in the working directory",
          "command": "git checkout <name>"
        },
        {
          "id": 10,
          "description": "Create a new branch and switch to it in the working directory",
          "command": "git checkout -b <name>"
        },
        {
          "id": 11,
          "description": "Delete a branch from the local repository",
          "command": "git branch -d <name>"
        }
      ]
    },
    {
      "id": 114,
      "topic": "Changes",
      "commands": [
        {
          "id": 12,
          "description": "Show the working directory status",
          "command": "git status"
        },
        {
          "id": 13,
          "description": "Stage a file to the staging area",
          "command": "git add <file>"
        },
        {
          "id": 14,
          "description": "Stage all changes in the working directory",
          "command": "git add ."
        },
        {
          "id": 15,
          "description": "Commit staged changes to the local repository",
          "command": "git commit -m \"message\""
        },
        {
          "id": 16,
          "description": "Amend the last commit in the local repository",
          "command": "git commit --amend"
        }
      ]
    },
    {
      "id": 115,
      "topic": "Remote",
      "commands": [
        {
          "id": 17,
          "description": "List all remote repositories linked to the local repository",
          "command": "git remote"
        },
        {
          "id": 18,
          "description": "Add a remote repository link to the local repository",
          "command": "git remote add <name> <url>"
        },
        {
          "id": 19,
          "description": "Remove a remote repository link from the local repository",
          "command": "git remote remove <name>"
        },
        {
          "id": 20,
          "description": "Fetch updates from a remote repository to the local repository",
          "command": "git fetch <remote>"
        },
        {
          "id": 21,
          "description": "Pull updates from a remote repository to the working directory",
          "command": "git pull <remote>"
        },
        {
          "id": 22,
          "description": "Push commits from the local repository to a remote repository",
          "command": "git push <remote> <branch>"
        }
      ]
    },
    {
      "id": 116,
      "topic": "Stashing",
      "commands": [
        {
          "id": 23,
          "description": "Save changes in the working directory temporarily",
          "command": "git stash"
        },
        {
          "id": 24,
          "description": "List all stashed changes",
          "command": "git stash list"
        },
        {
          "id": 25,
          "description": "Apply stashed changes to the working directory",
          "command": "git stash apply"
        },
        {
          "id": 26,
          "description": "Apply and remove the latest stash from the stash list",
          "command": "git stash pop"
        },
        {
          "id": 27,
          "description": "Drop a specific stash from the stash list",
          "command": "git stash drop"
        }
      ]
    },
    {
      "id": 117,
      "topic": "History",
      "commands": [
        {
          "id": 28,
          "description": "Show commit history in the local repository",
          "command": "git log"
        },
        {
          "id": 29,
          "description": "Show a condensed commit history in the local repository",
          "command": "git log --oneline"
        },
        {
          "id": 30,
          "description": "Show commit history as a graph in the local repository",
          "command": "git log --graph"
        },
        {
          "id": 31,
          "description": "Show detailed information about a specific commit",
          "command": "git show <commit>"
        }
      ]
    },
    {
      "id": 118,
      "topic": "Differences",
      "commands": [
        {
          "id": 32,
          "description": "Show differences in the working directory and staging area",
          "command": "git diff"
        },
        {
          "id": 33,
          "description": "Show differences between the staging area and the last commit",
          "command": "git diff --staged"
        }
      ]
    },
    {
      "id": 119,
      "topic": "Cleaning",
      "commands": [
        {
          "id": 34,
          "description": "Remove untracked files from the working directory",
          "command": "git clean -f"
        }
      ]
    },
    {
      "id": 120,
      "topic": "Tagging",
      "commands": [
        {
          "id": 35,
          "description": "List all tags in the local repository",
          "command": "git tag"
        },
        {
          "id": 36,
          "description": "Create a tag in the local repository",
          "command": "git tag <name>"
        },
        {
          "id": 37,
          "description": "Push a tag to the remote repository",
          "command": "git push <remote> <tag>"
        },
        {
          "id": 38,
          "description": "Delete a tag in the local repository",
          "command": "git tag -d <name>"
        },
        {
          "id": 39,
          "description": "Delete a tag in the remote repository",
          "command": "git push <remote> --delete <name>"
        }
      ]
    },
    {
      "id": 121,
      "topic": "Cherry-pick",
      "commands": [
        {
          "id": 40,
          "description": "Apply a commit from another branch to the current branch in the local repository",
          "command": "git cherry-pick <commit>"
        }
      ]
    },
    {
      "id": 122,
      "topic": "Reflog",
      "commands": [
        {
          "id": 41,
          "description": "Show a log of changes to HEAD in the local repository",
          "command": "git reflog"
        }
      ]
    },
    {
      "id": 123,
      "topic": "Bisect",
      "commands": [
        {
          "id": 42,
          "description": "Start a binary search to find the commit that introduced an issue",
          "command": "git bisect start"
        }
      ]
    },
    {
      "id": 124,
      "topic": "Submodules",
      "commands": [
        {
          "id": 43,
          "description": "Add a submodule to the working directory",
          "command": "git submodule add <repo> <path>"
        },
        {
          "id": 44,
          "description": "Initialize and update submodules in the working directory",
          "command": "git submodule update --init --recursive"
        }
      ]
    },
    {
      "id": 125,
      "topic": "Archive",
      "commands": [
        {
          "id": 45,
          "description": "Create a zipped archive of a branch",
          "command": "git archive --format=zip --output=<file.zip> <branch>"
        }
      ]
    },
    {
      "id": 126,
      "topic": "Blame",
      "commands": [
        {
          "id": 46,
          "description": "Show line-by-line history for a file",
          "command": "git blame <file>"
        }
      ]
    },
    {
      "id": 127,
      "topic": "Miscellaneous",
      "commands": [
        {
          "id": 47,
          "description": "Show a log of changes to HEAD in the local repository",
          "command": "git reflog"
        },
        {
          "id": 48,
          "description": "Show detailed information about a specific commit",
          "command": "git show <commit>"
        },
        {
          "id": 49,
          "description": "Apply a commit from another branch to the current branch in the local repository",
          "command": "git cherry-pick <commit>"
        },
        {
          "id": 50,
          "description": "Start a binary search to find the commit that introduced an issue",
          "command": "git bisect start"
        }
      ]
    }
  ]
}
